{
  "templates": {
    "rule_r5": "规则 R5（因果链）：部件 exhibits 现象 且 现象 impliesFault 故障 ⇒ 该故障列为候选",
    "rule_r6": "规则 R6（本体推理）：hasSeverity=4 的 FaultMode 被推理为 CriticalFault",
    "sec_symptom": "{i}. 观测到的现象「{symptom}」",
    "sec_fault": "{i}. 候选故障「{fault}」（严重度 {severity}{critical}）",
    "fact_indicates": "该现象在因果链上指向「{fault}」",
    "fact_shared": "同一故障被 {count} 个现象共同指向，置信度更高",
    "fact_remedy": "处置措施：{remedy}",
    "fact_no_remedy": "该故障未登记处置措施——诊断结果不完整",
    "conclusion_ranked": "按严重度与现象支持数排序，优先处置「{top}」",
    "conclusion_none": "该部件未登记任何现象，无法给出候选故障",
    "sec_check_ok": "故障「{fault}」已登记处置措施",
    "sec_check_bad": "故障「{fault}」缺少处置措施（维护手册不完整）",
    "sec_orphan_symptom": "现象「{symptom}」不指向任何故障，无法参与诊断"
  },
  "derivations": {
    "diagnose": [
      {
        "step": {
          "kind": "rule",
          "tpl": "rule_r5",
          "params": {}
        }
      },
      {
        "step": {
          "kind": "rule",
          "tpl": "rule_r6",
          "params": {}
        }
      },
      {
        "if": "$symptom_labels",
        "then": [
          {
            "loop": "$symptom_labels",
            "var": "s",
            "steps": [
              {
                "step": {
                  "kind": "section",
                  "tpl": "sec_symptom",
                  "params": {
                    "i": "$s.i",
                    "symptom": "$s.label"
                  }
                }
              },
              {
                "loop": "$s.fault_labels",
                "var": "f",
                "steps": [
                  {
                    "step": {
                      "kind": "fact",
                      "tpl": "fact_indicates",
                      "params": {
                        "fault": "$f"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ],
        "else": [
          {
            "step": {
              "kind": "conclusion",
              "tpl": "conclusion_none",
              "params": {}
            }
          }
        ]
      },
      {
        "if": "$faults",
        "then": [
          {
            "loop": "$faults",
            "var": "f",
            "steps": [
              {
                "step": {
                  "kind": "section",
                  "tpl": "sec_fault",
                  "params": {
                    "i": "$f.i",
                    "fault": "$f.label",
                    "severity": "$f.severity",
                    "critical": "$f.critical_mark"
                  }
                }
              },
              {
                "if": "$f.multi_support",
                "then": [
                  {
                    "step": {
                      "kind": "fact",
                      "tpl": "fact_shared",
                      "params": {
                        "count": "$f.support_count"
                      }
                    }
                  }
                ]
              },
              {
                "loop": "$f.remedy_labels",
                "var": "r",
                "steps": [
                  {
                    "step": {
                      "kind": "fact",
                      "tpl": "fact_remedy",
                      "params": {
                        "remedy": "$r"
                      }
                    }
                  }
                ]
              },
              {
                "if": "$f.no_remedy",
                "then": [
                  {
                    "step": {
                      "kind": "fact",
                      "tpl": "fact_no_remedy",
                      "params": {}
                    }
                  }
                ]
              }
            ]
          },
          {
            "step": {
              "kind": "conclusion",
              "tpl": "conclusion_ranked",
              "params": {
                "top": "$top_label"
              }
            }
          }
        ]
      }
    ],
    "consistency": [
      {
        "loop": "$checks",
        "var": "c",
        "steps": [
          {
            "step": {
              "kind": "fact",
              "tpl": "$c.tpl",
              "params": {
                "fault": "$c.label"
              }
            }
          }
        ]
      },
      {
        "loop": "$orphan_symptoms",
        "var": "o",
        "steps": [
          {
            "step": {
              "kind": "fact",
              "tpl": "sec_orphan_symptom",
              "params": {
                "symptom": "$o"
              }
            }
          }
        ]
      }
    ]
  }
}
