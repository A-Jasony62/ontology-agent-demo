# 「设备故障诊断」领域的 SHACL 形状：维护手册完整性约束。
#
# 与 agent_task 的形状异构——那边约束的是「任务必须有执行者」这类分配契约，
# 这边约束的是「诊断知识本身是否成链」：故障要有处置、部件要可观测、
# 现象要指向根因。形状文件随领域包走（G4 闸门按 @domain 哨兵解析到这里）。

@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix fd:   <http://example.org/fault_diag#> .

fd:ComponentShape
    a sh:NodeShape ;
    sh:targetClass fd:Component ;
    sh:property [
        sh:path fd:exhibits ;
        sh:minCount 1 ;
        sh:message "部件必须至少登记一个可观测现象，否则无法参与诊断" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "部件缺少中文名（rdfs:label）" ;
    ] .

fd:FaultModeShape
    a sh:NodeShape ;
    sh:targetClass fd:FaultMode ;
    sh:property [
        sh:path fd:hasRemedy ;
        sh:minCount 1 ;
        sh:message "故障模式必须至少登记一条处置措施，否则诊断结果无法落地" ;
    ] ;
    sh:property [
        sh:path fd:hasSeverity ;
        sh:minCount 1 ;
        sh:minInclusive 1 ;
        sh:maxInclusive 4 ;
        sh:message "故障模式必须给出 1–4 的严重度" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "故障模式缺少中文名（rdfs:label）" ;
    ] .

fd:SymptomShape
    a sh:NodeShape ;
    sh:targetClass fd:Symptom ;
    sh:property [
        sh:path fd:impliesFault ;
        sh:minCount 1 ;
        sh:message "现象必须至少指向一个故障模式，否则它是诊断上的死角" ;
    ] ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:message "现象缺少中文名（rdfs:label）" ;
    ] .
