<?xml version="1.0"?>
<!--
  「设备故障诊断」领域本体（第二个异构领域，用于验证插件框架的通用性）。

  与 agent_task 的结构差异是刻意的：
    agent_task  类=Agent/Task/Capability，边=can_execute（分配关系），
                业务操作是「把任务分给谁」；
    fault_diag  类=Equipment/Component/Symptom/FaultMode/Remedy，
                边=exhibits/impliesFault（因果链），业务操作是「这个现象说明什么坏了」。

  因此本领域**不实现** capability_match / orchestrate / assign / classify
  这些「任务编排」形状的方法——它声明了自定义能力 diagnose。

  推理钩子（不是摆设）：CriticalFault 用 owl:hasValue 定义为
  「hasSeverity 恰为 4 的 FaultMode」，诊断结果里的 critical 标记必须来自
  推理出的类型，而不是代码里比较数值。这样 G2/推理链是否真的在工作，
  一次 diagnose 就能证伪。
-->
<rdf:RDF xmlns="http://example.org/fault_diag#"
     xml:base="http://example.org/fault_diag"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

  <owl:Ontology rdf:about="http://example.org/fault_diag"/>

  <!-- ==================== 类层次 ==================== -->

  <owl:Class rdf:about="#Asset">
    <rdfs:label>资产</rdfs:label>
    <rdfs:comment>可被维护的对象的总称</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Equipment">
    <rdfs:subClassOf rdf:resource="#Asset"/>
    <rdfs:label>设备</rdfs:label>
    <rdfs:comment>整机，由若干部件组成</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Pump">
    <rdfs:subClassOf rdf:resource="#Equipment"/>
    <rdfs:label>泵</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="#Component">
    <rdfs:subClassOf rdf:resource="#Asset"/>
    <rdfs:label>部件</rdfs:label>
    <rdfs:comment>可独立更换的零件，是诊断的最小单元</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Bearing">
    <rdfs:subClassOf rdf:resource="#Component"/>
    <rdfs:label>轴承</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="#Coupling">
    <rdfs:subClassOf rdf:resource="#Component"/>
    <rdfs:label>联轴器</rdfs:label>
  </owl:Class>

  <owl:Class rdf:about="#Symptom">
    <rdfs:label>现象</rdfs:label>
    <rdfs:comment>可观测到的异常表现（振动/温度/异响），诊断的输入</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#FaultMode">
    <rdfs:label>故障模式</rdfs:label>
    <rdfs:comment>导致现象的根因，诊断的输出</rdfs:comment>
  </owl:Class>

  <!-- 推理产物类：不手工断言任何个体，全部由 hasSeverity=4 推出 -->
  <owl:Class rdf:about="#CriticalFault">
    <rdfs:subClassOf rdf:resource="#FaultMode"/>
    <owl:equivalentClass>
      <owl:Restriction>
        <owl:onProperty rdf:resource="#hasSeverity"/>
        <owl:hasValue rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</owl:hasValue>
      </owl:Restriction>
    </owl:equivalentClass>
    <rdfs:label>重大故障</rdfs:label>
    <rdfs:comment>严重度为 4 的故障模式，需立即停机处置</rdfs:comment>
  </owl:Class>

  <owl:Class rdf:about="#Remedy">
    <rdfs:label>处置措施</rdfs:label>
  </owl:Class>

  <!-- ==================== 对象属性 ==================== -->

  <owl:ObjectProperty rdf:about="#hasComponent">
    <rdfs:domain rdf:resource="#Equipment"/>
    <rdfs:range rdf:resource="#Component"/>
    <rdfs:label>包含部件</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#exhibits">
    <rdfs:domain rdf:resource="#Component"/>
    <rdfs:range rdf:resource="#Symptom"/>
    <rdfs:label>表现出</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#impliesFault">
    <rdfs:domain rdf:resource="#Symptom"/>
    <rdfs:range rdf:resource="#FaultMode"/>
    <rdfs:label>指向故障</rdfs:label>
    <rdfs:comment>因果链的正向：观察到该现象 ⇒ 怀疑该故障</rdfs:comment>
  </owl:ObjectProperty>

  <!-- 逆向边由 owl:inverseOf 推出（owlrl 支持 RL 规则 prp-inv），
       用于「已知根因，反查会有什么现象」的场景 -->
  <owl:ObjectProperty rdf:about="#indicatedBy">
    <owl:inverseOf rdf:resource="#impliesFault"/>
    <rdfs:label>由现象指向</rdfs:label>
  </owl:ObjectProperty>

  <owl:ObjectProperty rdf:about="#hasRemedy">
    <rdfs:domain rdf:resource="#FaultMode"/>
    <rdfs:range rdf:resource="#Remedy"/>
    <rdfs:label>处置措施</rdfs:label>
  </owl:ObjectProperty>

  <!-- ==================== 数据属性 ==================== -->

  <owl:DatatypeProperty rdf:about="#hasSeverity">
    <rdfs:domain rdf:resource="#FaultMode"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:label>严重度</rdfs:label>
    <rdfs:comment>1=轻微 2=一般 3=严重 4=重大</rdfs:comment>
  </owl:DatatypeProperty>

  <!-- ==================== 个体：设备与部件 ==================== -->

  <owl:NamedIndividual rdf:about="#pump_01">
    <rdf:type rdf:resource="#Pump"/>
    <rdfs:label>1号给水泵</rdfs:label>
    <hasComponent rdf:resource="#pump_01_bearing"/>
    <hasComponent rdf:resource="#pump_01_coupling"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#pump_01_bearing">
    <rdf:type rdf:resource="#Bearing"/>
    <rdfs:label>1号泵驱动端轴承</rdfs:label>
    <exhibits rdf:resource="#vibration_high"/>
    <exhibits rdf:resource="#temp_high"/>
    <exhibits rdf:resource="#noise_abnormal"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#pump_01_coupling">
    <rdf:type rdf:resource="#Coupling"/>
    <rdfs:label>1号泵联轴器</rdfs:label>
    <exhibits rdf:resource="#vibration_high"/>
  </owl:NamedIndividual>

  <!-- ==================== 个体：现象 ==================== -->

  <owl:NamedIndividual rdf:about="#vibration_high">
    <rdf:type rdf:resource="#Symptom"/>
    <rdfs:label>振动超标</rdfs:label>
    <impliesFault rdf:resource="#bearing_wear"/>
    <impliesFault rdf:resource="#misalignment"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#temp_high">
    <rdf:type rdf:resource="#Symptom"/>
    <rdfs:label>温度偏高</rdfs:label>
    <impliesFault rdf:resource="#lubrication_failure"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#noise_abnormal">
    <rdf:type rdf:resource="#Symptom"/>
    <rdfs:label>异常噪音</rdfs:label>
    <impliesFault rdf:resource="#bearing_wear"/>
  </owl:NamedIndividual>

  <!-- ==================== 个体：故障模式 ==================== -->

  <owl:NamedIndividual rdf:about="#bearing_wear">
    <rdf:type rdf:resource="#FaultMode"/>
    <rdfs:label>轴承磨损</rdfs:label>
    <hasSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</hasSeverity>
    <hasRemedy rdf:resource="#replace_bearing"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#misalignment">
    <rdf:type rdf:resource="#FaultMode"/>
    <rdfs:label>对中不良</rdfs:label>
    <hasSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</hasSeverity>
    <hasRemedy rdf:resource="#realign_coupling"/>
    <hasRemedy rdf:resource="#inspect_alignment"/>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#lubrication_failure">
    <rdf:type rdf:resource="#FaultMode"/>
    <rdfs:label>润滑失效</rdfs:label>
    <hasSeverity rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</hasSeverity>
    <hasRemedy rdf:resource="#add_lubricant"/>
  </owl:NamedIndividual>

  <!-- ==================== 个体：处置措施 ==================== -->

  <owl:NamedIndividual rdf:about="#replace_bearing">
    <rdf:type rdf:resource="#Remedy"/>
    <rdfs:label>更换轴承</rdfs:label>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#realign_coupling">
    <rdf:type rdf:resource="#Remedy"/>
    <rdfs:label>联轴器重新对中</rdfs:label>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#inspect_alignment">
    <rdf:type rdf:resource="#Remedy"/>
    <rdfs:label>复核对中数据</rdfs:label>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="#add_lubricant">
    <rdf:type rdf:resource="#Remedy"/>
    <rdfs:label>补充/更换润滑脂</rdfs:label>
  </owl:NamedIndividual>

</rdf:RDF>
