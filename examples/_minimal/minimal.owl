<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/minimal#"
     xml:base="http://example.org/minimal"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:owl="http://www.w3.org/2002/07/owl#">

  <owl:Ontology rdf:about="http://example.org/minimal"/>

  <owl:Class rdf:about="http://example.org/minimal#Item">
    <rdfs:label>条目</rdfs:label>
  </owl:Class>

  <owl:ObjectProperty rdf:about="http://example.org/minimal#relates_to">
    <rdfs:label>关联</rdfs:label>
  </owl:ObjectProperty>

  <owl:NamedIndividual rdf:about="http://example.org/minimal#item1">
    <rdf:type rdf:resource="http://example.org/minimal#Item"/>
    <rdfs:label>条目一</rdfs:label>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="http://example.org/minimal#item2">
    <rdf:type rdf:resource="http://example.org/minimal#Item"/>
    <rdfs:label>条目二</rdfs:label>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="http://example.org/minimal#item3">
    <rdf:type rdf:resource="http://example.org/minimal#Item"/>
    <rdfs:label>条目三</rdfs:label>
  </owl:NamedIndividual>

  <owl:NamedIndividual rdf:about="http://example.org/minimal#item1">
    <relates_to rdf:resource="http://example.org/minimal#item2"/>
  </owl:NamedIndividual>

</rdf:RDF>
